{
  "name": "pomone",
  "version": "0.1.0",
  "description": "Du classeur du verger aux pages HTML : plan visuel et fiches des arbres, hors ligne.",
  "license": "MIT",
  "author": "François Houdebert",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cli": "esbuild packages/cli/src/pomone.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-cli/pomone.cjs --banner:js=\"#!/usr/bin/env node\"",
    "pomone": "tsx packages/cli/src/pomone.ts",
    "test": "vitest run",
    "test:e2e": "tsx e2e/pages.ts",
    "licences": "node outils/licences.mjs",
    "typecheck": "tsc --noEmit",
    "exemple": "tsx packages/cli/src/pomone.ts build exemples/verger-arboretum.xlsx -o site --unique",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "fflate": "^0.8.3",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
